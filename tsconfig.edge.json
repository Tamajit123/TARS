{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "npm:fflate@0.8.3": ["./node_modules/fflate"],
      "npm:ajv@8.20.0": ["./node_modules/ajv"],
      "npm:@supabase/supabase-js@2.118.0": ["./node_modules/@supabase/supabase-js"]
    }
  },
  "include": ["supabase/functions/**/*.ts"]
}
