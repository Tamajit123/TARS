# Public client configuration. These values are safe to include in the mobile app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
# Optional public MapLibre style URL. Default: OpenFreeMap Liberty with attribution.
# EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# All provider keys belong in the EXISTING Supabase project's Edge Function
# secrets, never in an EXPO_PUBLIC variable. See docs/PROVIDER_OPERATIONS.md.
