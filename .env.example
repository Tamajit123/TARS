# Public client configuration. These values are safe to include in the mobile app.
EXPO_PUBLIC_SUPABASE_URL=url
EXPO_PUBLIC_SUPABASE_ANON_KEY=url
# Optional. Only needed for the legacy local Expo API routes used by external tool linking.
# Never place service role, AI provider, Composio, Browserbase, or scheduler secrets here.
# EXPO_PUBLIC_API_URL=https://your-trusted-api.example.com
